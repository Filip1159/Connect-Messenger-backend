  "components" : {
    "schemas" : {
      "AddMembersRequest" : {
        "type" : "object",
        "properties" : {
          "userIds" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int64"
            }
          }
        }
      },
      "ChatDto" : {
        "required" : [ "archived", "group", "id", "messages", "muted", "status", "unreadCount", "users" ],
        "type" : "object",
        "properties" : {
          "adminIds" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int64"
            }
          },
          "archived" : {
            "type" : "boolean"
          },
          "group" : {
            "type" : "boolean"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "messages" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/MessageDto"
            }
          },
          "muted" : {
            "type" : "boolean"
          },
          "name" : {
            "type" : "string"
          },
          "status" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/StatusDto"
            }
          },
          "unreadCount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "users" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/UserDto"
            }
          }
        }
      },
      "CreateChatRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "userIds" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int64"
            }
          }
        }
      },
      "CreateMessageRequest" : {
        "type" : "object",
        "properties" : {
          "chatId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "fileContent" : {
            "type" : "string",
            "format" : "binary"
          },
          "replyToId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "textContent" : {
            "type" : "string"
          },
          "time" : {
            "type" : "string",
            "format" : "date-time"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "TEXT", "FILE" ]
          },
          "userId" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "EditMessageRequest" : {
        "type" : "object",
        "properties" : {
          "textContent" : {
            "type" : "string"
          }
        }
      },
      "Id" : {
        "required" : [ "chatId", "userId" ],
        "type" : "object",
        "properties" : {
          "chatId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "userId" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "MessageDto" : {
        "required" : [ "chatId", "content", "deleted", "id", "reactions", "time", "type", "userId" ],
        "type" : "object",
        "properties" : {
